#cloud-config
hostname: pilab-bootstrap
manage_etc_hosts: true
ssh_pwauth: false
disable_root: true

users:
  - name: klevis
    gecos: Pi Appliance Development Administrator
    groups: [adm, sudo]
    shell: /bin/bash
    lock_passwd: true
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - __SSH_PUBLIC_KEY__

package_update: true
packages:
  - openssh-server
  - git
  - jq
  - rsync
  - parted
  - gdisk

write_files:
  - path: /etc/ssh/sshd_config.d/20-pi-appliance.conf
    owner: root:root
    permissions: "0644"
    content: |
      PermitRootLogin no
      PubkeyAuthentication yes
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitEmptyPasswords no
  - path: /etc/pi-appliance/bootstrap-release
    owner: root:root
    permissions: "0644"
    content: |
      development

runcmd:
  - [systemctl, enable, ssh]
  - [systemctl, restart, ssh]
  - [mkdir, -p, /opt/pi-appliance]
  - [bash, -c, "if [ -d /opt/pi-appliance/.git ]; then git -C /opt/pi-appliance fetch origin main && git -C /opt/pi-appliance reset --hard origin/main; else rm -rf /opt/pi-appliance; git clone --branch main --single-branch https://github.com/klevisa/pi-appliance.git /opt/pi-appliance || { rm -rf /opt/pi-appliance; mkdir -p /opt/pi-appliance; if [ -f /boot/firmware/pi-appliance-source.tar.gz ]; then tar -xzf /boot/firmware/pi-appliance-source.tar.gz -C /opt/pi-appliance --strip-components=1; else exit 1; fi; }; fi"]
  - [chown, -R, "klevis:klevis", /opt/pi-appliance]
  - [bash, -c, "if [ -x /opt/pi-appliance/scripts/install-development-bootstrap.sh ]; then /opt/pi-appliance/scripts/install-development-bootstrap.sh; fi"]

final_message: "Pi appliance bootstrap provisioning complete after $UPTIME seconds"
